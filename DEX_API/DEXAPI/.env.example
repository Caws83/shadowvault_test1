# =============================================================================
# DEX API (Railway / Docker / local)
#
# Local:  copy to `.env` in this folder →  cp .env.example .env  (then fill secrets)
# Never commit `.env` (gitignored).
# Production: set the SAME variable NAMES in Railway → Variables (not Netlify).
# =============================================================================
#
# CHECKLIST — if "keys work locally" but production fails:
#
# 1) Netlify (frontend): set VITE_API_URL=https://YOUR-API.up.railway.app and REDEPLOY.
#    Without this, the SPA may call the wrong host (see config default in the frontend).
#
# 2) Railway (this API): add FRONTEND_ORIGINS if the site uses a CUSTOM DOMAIN (not *.netlify.app).
#    Example: FRONTEND_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
#    The API allows *.netlify.app and marswap.exchange hosts by default; other domains need this.
#
# 3) Railway: confirm variables are attached to the DEX API service (not only a shared bucket
#    that no service references). Redeploy after changing variables.
#
# WHERE KEYS LIVE
# ---------------
# Railway (this API):  CHANGENOW_*, HYPERLIQUID_*, OPENAI_API_KEY, FRONTEND_ORIGINS, PORT
# Netlify (browser):   VITE_* only — e.g. VITE_API_URL=https://YOUR-API.up.railway.app
#
# ChangeNOW and Hyperliquid secrets NEVER go in Netlify — the frontend calls YOUR API,
# and the API calls ChangeNOW / Hyperliquid with keys from Railway.
#
# If you see "CHANGENOW_API_KEY is not configured" in production, the key is missing on
# Railway (or wrong name). Setting it only in Netlify will NOT fix it.
#
# If you see "Hyperliquid agent wallet not configured", add HYPERLIQUID_AGENT_PRIVATE_KEY
# on Railway (0x + 64 hex). The trading wallet must be approved as an API wallet on HL.
#
# --- Checklist vs a typical Railway service (game RPCs + ChangeNOW + OpenAI only) ---
# Still add on Railway if you use these features:
#   FRONTEND_ORIGINS     — custom domain CORS (comma-separated origins, no trailing /)
#   HYPERLIQUID_*        — perps: at minimum HYPERLIQUID_AGENT_PRIVATE_KEY (+ optional ADDRESS)
#
# Deployer wallet (contract deploys) vs Hyperliquid agent:
#   The API does not use a "deployer address" env var for HL. Orders are signed by the wallet
#   whose PRIVATE KEY is in HYPERLIQUID_AGENT_PRIVATE_KEY. That address should match an API
#   wallet you approved in the Hyperliquid UI for your master trading account. You may use
#   the same key as your deployer only if that is intentional — never commit keys; Railway only.
#   Optional: set HYPERLIQUID_AGENT_ADDRESS=0x... to the checksummed pubkey of that key.
# =============================================================================

PORT=3000

# CORS: your Netlify / custom domain origins (comma-separated, no trailing slashes).
# Example: https://yoursite.netlify.app,https://www.example.com
# Legacy single origin (optional; prefer FRONTEND_ORIGINS):
# FRONTEND_ORIGIN=
FRONTEND_ORIGINS=

# --- OpenAI (optional: AI helper / agent; server starts without it) ---
OPENAI_API_KEY=

# ShadowVault Bot (Bots tab)
SHADOW_VAULT_API_URL=
SHADOW_VAULT_API_KEY=

# --- ChangeNOW (AnonSwap proxy: /api/changenow/*) — REQUIRED on Railway for swaps ---
# Alias supported: CHANGENOW_KEY (same value as CHANGENOW_API_KEY if you prefer)
CHANGENOW_API_KEY=
CHANGENOW_BASE_URL=https://api.changenow.io

# --- Hyperliquid (perps: /api/hyperliquid/*) — signing keys ONLY on Railway ---
# Network: mainnet | testnet
HYPERLIQUID_NETWORK=mainnet
# Mainnet kill switch for signed routes (order/cancel/leverage). Default true. Ignored on testnet.
HYPERLIQUID_MAINNET_ENABLED=true
# Optional URL overrides (defaults are correct for network):
# HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
#
# Agent private key: 0x + 64 hex (or 64 hex without 0x — both accepted).
# Must be approved on Hyperliquid for the account you trade for.
HYPERLIQUID_AGENT_PRIVATE_KEY=
# Optional: must match the key above if set
HYPERLIQUID_AGENT_ADDRESS=
# Optional: vault / subaccount address
HYPERLIQUID_VAULT_ADDRESS=
HYPERLIQUID_INFO_TIMEOUT_MS=15000
HYPERLIQUID_EXCHANGE_TIMEOUT_MS=20000
HYPERLIQUID_INFO_MAX_RETRIES=3
HYPERLIQUID_INFO_RETRY_INITIAL_MS=300
HYPERLIQUID_ORDERBOOK_POLL_MS=1500
HYPERLIQUID_STALE_MS=12000
HYPERLIQUID_RECONCILE_MS=30000

ENABLE_DOCS_BOOT=false

BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

BSC_TESTNET_FACTORY=0x0000000000000000000000000000000000000000
BSC_TESTNET_INFO_GETTER=0x0000000000000000000000000000000000000000
SEPOLIA_FACTORY=0x0000000000000000000000000000000000000000
SEPOLIA_INFO_GETTER=0x0000000000000000000000000000000000000000
ETHEREUM_FACTORY=0x0000000000000000000000000000000000000000
ETHEREUM_INFO_GETTER=0x0000000000000000000000000000000000000000

NFT_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
NFT_CHAIN_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

PKEY=

BSC_TESTNET_GAME_TOKEN=
BSC_TESTNET_GAME_ROUTER=
BSC_TESTNET_GAME_MARSHOT=
BSC_TESTNET_GAME_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
SEPOLIA_GAME_TOKEN=
SEPOLIA_GAME_ROUTER=
SEPOLIA_GAME_MARSHOT=
SEPOLIA_GAME_RPC=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_GAME_TOKEN=
ETHEREUM_GAME_ROUTER=
ETHEREUM_GAME_MARSHOT=
ETHEREUM_GAME_RPC=https://ethereum-rpc.publicnode.com
