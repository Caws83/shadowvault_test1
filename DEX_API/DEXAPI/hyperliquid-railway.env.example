# =============================================================================
# Copy variable NAMES and values into Railway → your DEX API service → Variables
# (or Raw Editor). Fill secrets only in Railway — never commit real keys.
#
# WHERE TO GET HYPERLIQUID_AGENT_PRIVATE_KEY
# ------------------------------------------
# Hyperliquid does NOT give you this. It is the SECRET KEY of an Ethereum wallet
# YOU control (64 hex chars, usually shown as 0x + 64 hex).
#
# Recommended flow:
#   1) Create a NEW wallet only for API trading (MetaMask → Account details → Export
#      private key) OR generate one offline — treat it like a hot API key.
#   2) Put that key ONLY in Railway as HYPERLIQUID_AGENT_PRIVATE_KEY.
#   3) On https://app.hyperliquid.xyz log in with your MAIN trading account (where
#      your margin lives) and approve this wallet as an "API" / agent wallet so it
#      may sign orders on your behalf.
#
# Optional: set HYPERLIQUID_AGENT_ADDRESS to the checksummed address of that key
# (must match the private key). Leave HYPERLIQUID_VAULT_ADDRESS empty unless you use a vault.
#
# Testnet: set HYPERLIQUID_NETWORK=testnet and use testnet HL + test funds.
# =============================================================================

HYPERLIQUID_NETWORK=mainnet
HYPERLIQUID_MAINNET_ENABLED=true

HYPERLIQUID_AGENT_PRIVATE_KEY=
HYPERLIQUID_AGENT_ADDRESS=
HYPERLIQUID_VAULT_ADDRESS=

HYPERLIQUID_INFO_TIMEOUT_MS=15000
HYPERLIQUID_EXCHANGE_TIMEOUT_MS=20000
HYPERLIQUID_INFO_MAX_RETRIES=3
HYPERLIQUID_INFO_RETRY_INITIAL_MS=300
HYPERLIQUID_ORDERBOOK_POLL_MS=1500
HYPERLIQUID_STALE_MS=12000
HYPERLIQUID_RECONCILE_MS=30000

# Optional overrides (defaults match official HL endpoints for the network):
# HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
