# Frontend (Vite) — commit-safe template.
# Local dev: copy relevant lines into `.env.development` or `.env.local` (gitignored).
# Production / Netlify: set VITE_* in the site Environment variables.
# NEVER put Hyperliquid private keys or ChangeNOW API keys here — DEX API only.

# API base (no trailing slash). Local default matches DEX API PORT=3000:
# VITE_API_URL=http://localhost:3000
# Production example:
# VITE_API_URL=https://your-app.up.railway.app
VITE_API_URL=

# Optional: AI panel (often same origin as VITE_API_URL)
# VITE_AI_AGENT_API_URL=
# VITE_ENABLE_AI_AGENT=true

VITE_CHAIN_ID=109
VITE_GTAG=GTM-TLF66T4

# Local dev: see .env.development (uses http://localhost:3000 for API)
