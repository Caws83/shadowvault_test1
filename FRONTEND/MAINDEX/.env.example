# ShadowVault — FRONTEND/MAINDEX (npm package: shadowvault-protocol-frontend)
#
# Production = static `dist/` from `npm run build` (Vite is the bundler only; nothing runs Vite on the server).
# DEX API = repo folder DEX_API/DEXAPI (Express). Secrets stay there, not in VITE_*.
#
# Netlify: set VITE_API_URL=https://your-dex.up.railway.app at build time for _redirects + API calls.
# Local: leave VITE_API_URL empty; app uses http://<hostname>:3000 — run DEX_API/DEXAPI on PORT 3000.
# VITE_API_URL=https://your-dex.up.railway.app
VITE_API_URL=

# Optional: AI panel (often same origin as VITE_API_URL)
# VITE_AI_AGENT_API_URL=
# VITE_ENABLE_AI_AGENT=true

VITE_CHAIN_ID=109
VITE_GTAG=GTM-TLF66T4

# Local dev: see .env.development (uses http://localhost:3000 for API)
