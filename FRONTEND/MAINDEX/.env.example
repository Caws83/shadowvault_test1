# Frontend (Vite) — commit-safe template. Copy to .env.development / use Netlify env for production.
# NEVER put Hyperliquid private keys or ChangeNOW API keys here; those belong on Railway (DEX API).

# Required for production builds: your deployed DEX API base URL (no trailing slash).
# Example: https://your-app.up.railway.app
VITE_API_URL=

# Optional: AI panel (often same origin as VITE_API_URL)
# VITE_AI_AGENT_API_URL=
# VITE_ENABLE_AI_AGENT=true

VITE_CHAIN_ID=109
VITE_GTAG=GTM-TLF66T4

# Local dev: see .env.development (uses http://localhost:3000 for API)
